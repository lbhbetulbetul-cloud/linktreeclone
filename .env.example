# =============================================================================
# LINKTREE CLONE MVP - ENVIRONMENT VARIABLES
# =============================================================================

# Vite Application Configuration
VITE_APP_URL=http://localhost:5173

# Supabase Configuration
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
VITE_PUBLIC_APP_URL=http://localhost:5173

# Optional: For local Supabase development
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# =============================================================================
# PRODUCTION VARIABLES (untuk deployment)
# =============================================================================

# Uncomment dan sesuaikan untuk production:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-production-anon-key
# VITE_PUBLIC_APP_URL=https://yourdomain.com
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# Untuk development lokal:
# 1. Copy file ini ke .env.local
# 2. Sesuaikan nilai sesuai project Supabase Anda
# 3. Jalankan 'supabase start' untuk mendapatkan key lokal
# 4. Check Supabase dashboard untuk production keys

# Cara mendapatkan keys:
# 1. supabase start (untuk local)
# 2. supabase status (untuk melihat local keys)  
# 3. Supabase dashboard > Settings > API (untuk production)

# Security Notes:
# - Jangan pernah commit .env.local ke git
# - SUPABASE_SERVICE_ROLE_KEY harus保密
# - Gunakan variabel yang berbeda untuk production