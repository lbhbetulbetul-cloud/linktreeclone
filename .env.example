# =============================================================================
# SUPABASE LINK-IN-BIO PLATFORM ENVIRONMENT VARIABLES
# =============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Database URL (for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Development Environment
NODE_ENV=development
NEXT_PUBLIC_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-local-secret-key

# =============================================================================
# PRODUCTION VARIABLES (untuk deployment)
# =============================================================================

# Uncomment dan sesuaikan untuk production:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
# NODE_ENV=production
# NEXT_PUBLIC_ENV=production
# NEXTAUTH_URL=https://your-domain.com
# NEXTAUTH_SECRET=your-secure-production-secret

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# Email Configuration (untuk notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Analytics (optional)
# ANALYTICS_API_KEY=your-analytics-key
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# External Services
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Social Authentication (jika diperlukan)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# Untuk development lokal:
# 1. Copy file ini ke .env.local
# 2. Sesuaikan nilai sesuai project Supabase Anda
# 3. Jalankan 'supabase start' untuk mendapatkan key lokal
# 4. Check Supabase dashboard untuk production keys

# Cara mendapatkan keys:
# 1. supabase start (untuk local)
# 2. supabase status (untuk melihat local keys)
# 3. Supabase dashboard > Settings > API (untuk production)

# Security Notes:
# - Jangan pernah commit .env.local ke git
# - SUPABASE_SERVICE_ROLE_KEY harus保密
# - Gunakan NEXTAUTH_SECRET yang unik untuk production